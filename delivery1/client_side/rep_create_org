#!/usr/bin/env python
# -*- coding: utf-8 -*-

# ./rep_create_org <organization> <username> <name> <email> <public key file>

import os
import sys
import json
import logging
import argparse
import requests
import state_handler as sh

logging.basicConfig(format='%(levelname)s\t- %(message)s')
logger = logging.getLogger()
logger.setLevel(logging.INFO)

def parse_args():
    # Configura o analisador de argumentos
    parser = argparse.ArgumentParser()
    parser.add_argument("organization", help="Name of the organization")
    parser.add_argument("username", help="Username associated with the organization")
    parser.add_argument("name", help="Full name of the user")
    parser.add_argument("email", help="Email of the user")
    parser.add_argument("public_key_file", help="Path to the public key file")
    parser.add_argument("-v", '--verbose', help="Increase verbosity", action="store_true")

    args = parser.parse_args()
    if args.verbose:
        logger.setLevel(logging.DEBUG)
        logger.info('Setting log level to DEBUG')

    # Cria o estado inicial com os argumentos fornecidos
    state = {
        "organization": args.organization,
        "username": args.username,
        "name": args.name,
        "email": args.email
    }

    # Verifica se o arquivo de chave pública existe
    if not os.path.exists(args.public_key_file):
        logger.error(f'Public key file not found: {args.public_key_file}')
        sys.exit(-1)

    # Lê o conteúdo do arquivo de chave pública
    with open(args.public_key_file, 'r') as f:
        state['REP_PUB_KEY'] = f.read()
        logger.info('Loaded public key from file')

    return state

def send_request_to_server(state):
    # Define a URL do servidor
    url = f"http://{state['REP_ADDRESS']}/organization/create"
    data = {
        "organization": state["organization"],
        "username": state["username"],
        "name": state["name"],
        "email": state["email"],
        "public_key": state["REP_PUB_KEY"]
    }

    try:
        # Envia a solicitação POST para o servidor
        response = requests.post(url, json=data)
        response.raise_for_status()  # Raises an error if the response is an HTTP error code
        logger.info(f"Organization created successfully: {response.json().get('message')}")
    except requests.exceptions.RequestException as e:
        logger.error(f"Failed to create organization: {e}")

def main():
    # Carrega, ajusta e salva o estado
    state = sh.load_state()
    state = sh.parse_env(state)
    state.update(parse_args())

    # Define o endereço padrão se não estiver no estado
    state['REP_ADDRESS'] = state.get('REP_ADDRESS', '127.0.0.1:5000')

    send_request_to_server(state)

    sh.save(state)

if __name__ == '__main__':
    main()