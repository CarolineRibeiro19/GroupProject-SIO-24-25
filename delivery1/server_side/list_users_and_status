import sqlite3

def list_users_and_status():
    # Conectar ao banco de dados
    conn = sqlite3.connect('repository.db')
    cursor = conn.cursor()

    try:
        # Consultar os dados de usuários e status
        cursor.execute("SELECT username, status FROM subjects")
        users = cursor.fetchall()

        if not users:
            print("No users found in the database.")
        else:
            print(f"{'Username':<20} {'Status'}")
            print("="*40)
            for user in users:
                username, status = user
                print(f"{username:<20} {status}")
        
    except Exception as e:
        print(f"Error: {e}")
    finally:
        # Fechar a conexão com o banco de dados
        conn.close()

if __name__ == '__main__':
    list_users_and_status()
